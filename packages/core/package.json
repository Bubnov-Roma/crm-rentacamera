{
  "name": "@rentacamera/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "type-check:ci": "tsc --noEmit --skipLibCheck --noImplicitAny false",
    "security:audit": "pnpm audit --audit-level high",
    "security:check": "pnpm outdated && pnpm audit",
    "security:fix": "pnpm audit fix"
  },
  "dependencies": {
    "lib0": "^0.2.101",
    "yjs": "^13.6.8",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@prisma/client": "^6.17.1",
    "@types/node": "^20.10.0",
    "prisma": "^6.17.1",
    "typescript": "^5.3.3"
  }
}
