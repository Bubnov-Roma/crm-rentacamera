// more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USERS AND ROLE ====================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  avatar       String?
  // roles
  role         UserRole  @default(CLIENT)
  // profiles 
  client       Client?
  employee     Employee?
  partner      Partner?
  // audit fields
  isActive     Boolean   @default(true)
  isVerified   Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  // relations
  sessions     Session[]

  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  CLIENT
  PARTNER
}

model Client {
  id                    String       @id @default(cuid())
  userId                String       @unique
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // additional fields for client profile
  clientType            ClientType   @default(INDIVIDUAL)
  documentType          String?
  documentNumber        String?
  dateOfBirth           DateTime?
  companyName           String?
  taxId                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  // statistics
  totalBookings         Int          @default(0)
  totalSpent            Float        @default(0)
  loyaltyLevel          LoyaltyLevel @default(STANDARD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

enum ClientType {
  INDIVIDUAL
  LEGAL
  PARTNER
}

enum LoyaltyLevel {
  STANDARD
  SILVER
  GOLD
}

model Employee {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // additional fields for employee profile
  position    String // manager, technician, consultant
  hireDate    DateTime
  isActive    Boolean  @default(true)
  permissions String?
  // statistics
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("employees")
}

model Partner {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // additional fields for partner profile
  partnerType    PartnerType    @default(INDIVIDUAL)
  companyName    String?
  taxId          String?
  bankAccount    String?
  commissionRate Float? // %
  paymentMethod  PaymentMethod?
  contractNumber String?
  isActive       Boolean        @default(true)

  Equipment Equipment[]
  // statistics
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("partners")
}

enum PartnerType {
  INDIVIDUAL
  LEGAL
}

enum PaymentMethod {
  FIXED
  PERCENTAGE
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // session details
  token     String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("sessions")
}

// ====================  EQUIPMENT & CATEGORY  ====================
model EquipmentCategory {
  id           String              @id @default(cuid())
  name         String              @unique
  slug         String              @unique
  description  String?
  image        String?
  parentId     String?
  // hierarchy categories 
  parent       EquipmentCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     EquipmentCategory[] @relation("CategoryHierarchy")
  // prices
  hourlyRate   Float
  dailyRate    Float
  monthlyRate  Float
  // additional fields
  pricingRules String? // JSON or custom format for pricing rules
  customFields String? // JSON or custom fields for specific categories
  sortOrder    Int                 @default(0)
  isActive     Boolean             @default(true)
  viewType     ViewType            @default(LIST)
  // equipment
  equipment    Equipment[]
  // audit fields
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@map("equipment_categories")
}

enum ViewType {
  TREE
  LIST
  GRID
}

model Equipment {
  id              String              @id @default(cuid())
  sku             String              @unique
  name            String
  description     String?
  // category
  categoryId      String
  category        EquipmentCategory   @relation(fields: [categoryId], references: [id])
  // brand, model, serial number
  brand           String
  model           String
  serialNumber    String              @unique
  // specifications
  specifications  String // JSON or custom format for specifications
  // prices
  baseHourlyRate  Float
  baseDailyRate   Float
  baseMonthlyRate Float
  depositAmount   Float
  replacementCost Float
  pricingMatrix   String // JSON or custom format for complex pricing
  // metadata
  tags            String? // array of tags/keywords
  comments        String?
  images          String[] // array of image URLs
  manuals         String[] // array of manual URLs
  // status and condition
  status          EquipmentStatus     @default(ACTIVE)
  isPublic        Boolean             @default(true)
  // partner/vendor
  partnerId       String?
  partner         Partner?            @relation(fields: [partnerId], references: [id])
  // relations
  instances       EquipmentInstance[]
  // audit fields
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@map("equipment")
}

enum EquipmentStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
  // AVAILABLE
  // RENTED
  // MAINTENANCE
  // RESERVED
  // DAMAGED
  // LOST
}

model EquipmentInstance {
  id                   String                  @id @default(cuid())
  // unique identifier for the physical item
  serialNumber         String                  @unique
  internalId           String // CAM-001-EKB-P1-O
  // link to the equipment model
  equipmentId          String
  equipment            Equipment               @relation(fields: [equipmentId], references: [id])
  // status and condition
  status               EquipmentInstanceStatus @default(AVAILABLE)
  condition            EquipmentCondition      @default(EXCELLENT)
  // inventory details
  inventoryNumber      String? // internal tracking number
  barcode              String? // barcode or QR code
  // history maintenance
  purchaseDate         DateTime?
  purchasePrice        Float?
  lastMaintenanceDate  DateTime?
  nextMaintenanceDate  DateTime?
  // details
  configurationDetails String? // complication details
  defectsDescription   String? // description of any defects
  notes                String?
  // audit fields
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@map("equipment_instances")
}

enum EquipmentInstanceStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  RESERVED
  DAMAGED
  LOST
}

enum EquipmentCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum Condition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}