model BookingChange {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  
  field     String
  oldValue  String?
  newValue  String?
  reason    String?
  
  changedById String
  changedBy   User   @relation(fields: [changedById], references: [id])
  
  createdAt DateTime @default(now())

  @@map("booking_changes")
}

model SystemLog {
  id        String   @id @default(cuid())
  action    String
  entityId  String?
  details   Json?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now())

  @@map("system_logs")
}

model Review {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  
  rating    Int      // 1-5
  comment   String?
  isActive  Boolean  @default(true)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}

model MaintenanceRecord {
  id          String   @id @default(cuid())
  equipmentInstanceId String
  equipmentInstance EquipmentInstance @relation(fields: [equipmentInstanceId], references: [id])
  
  type        MaintenanceType
  description String
  cost        Float?
  
  performedById String?
  performedBy Employee? @relation(fields: [performedById], references: [id])
  
  scheduledDate DateTime?
  completedDate DateTime?
  status      MaintenanceStatus @default(SCHEDULED)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("maintenance_records")
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  
  assignedToId String?
  assignedTo Employee? @relation(fields: [assignedToId], references: [id])

  // relation with User
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])

  
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(PENDING)
  dueDate     DateTime?
  
  // for linking to equipment
  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tasks")
}


enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaintenanceType {
  ROUTINE
  REPAIR
  INSPECTION
  CLEANING
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

