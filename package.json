{
  "name": "crm-rentacamera",
  "version": "1.0.0",
  "private": true,
  "description": "CRM system for renting photo and video equipment",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint --edit",
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "type-check": "turbo type-check",
    "type-check:ci": "turbo type-check:ci",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "db:studio": "turbo db:studio",
    "setup": "./scripts/setup.sh",
    "security:audit": "pnpm audit --audit-level high",
    "security:check": "pnpm outdated && pnpm audit",
    "security:fix": "pnpm audit fix"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored"
    ],
    "*.{json,md,mdx,css,html,yml,yaml}": [
      "prettier --write"
    ],
    "packages/database/prisma/schema.prisma": [
      "cd packages/database && prisma format"
    ],
    "*.config.js": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.37.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "prettier": "^3.1.1",
    "prisma": "^6.17.1",
    "turbo": "^2.5.8",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "glob": "^10.5.0",
    "web-push": "^3.6.7"
  },
  "pnpm": {
    "overrides": {
      "glob": "10.5.0",
      "validator": ">=13.15.22",
      "jws": ">=4.0.1",
      "esbuild": ">=0.25.0",
      "vite": ">=5.4.21",
      "next-auth": ">=4.24.12",
      "js-yaml": ">=4.1.1"
    }
  }
}
