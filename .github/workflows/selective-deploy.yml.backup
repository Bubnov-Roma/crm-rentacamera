name: Selective Deploy

on:
  push:
    branches: [main]

jobs:
  detect-changes:
    name: Detect Changed Packages
    runs-on: ubuntu-latest
    outputs:
      web-changed: ${{ steps.changes.outputs.web }}
      admin-changed: ${{ steps.changes.outputs.admin }}
      core-changed: ${{ steps.changes.outputs.core }}
      database-changed: ${{ steps.changes.outputs.database }}

    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 2

      - name: Detect changes
        id: changes
        uses: dorny/paths-filter@v2
        with:
          filters: |
            web:
              - 'apps/web/**'
              - 'packages/ui/**'
              - 'packages/core/**'
            admin:
              - 'apps/admin/**'
              - 'packages/ui/**'
              - 'packages/core/**'
            core:
              - 'packages/core/**'
            database:
              - 'packages/database/**'

  deploy-web:
    name: Deploy Web (if changed)
    runs-on: ubuntu-latest
    needs: detect-changes
    if: needs.detect-changes.outputs.web-changed == 'true'

    steps:
      - name: Deploy Web App
        run: echo "Deploying web app..."
        # for web deploy

  deploy-admin:
    name: Deploy Admin (if changed)
    runs-on: ubuntu-latest
    needs: detect-changes
    if: needs.detect-changes.outputs.admin-changed == 'true'

    steps:
      - name: Deploy Admin App
        run: echo "Deploying admin app..."
        # for admin deploy

  deploy-database:
    name: Deploy Database (if changed)
    runs-on: ubuntu-latest
    needs: detect-changes
    if: needs.detect-changes.outputs.database-changed == 'true'

    steps:
      - name: Deploy Database Migrations
        run: echo "Running database migrations..."
        # for db migration
