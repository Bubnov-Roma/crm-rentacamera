      #   with:
      #     script: |
      #       const tag = `release-${new Date().toISOString().split('T')[0]}`;
      #       await github.rest.git.createRef({
      #         owner: context.repo.owner,
      #         repo: context.repo.repo,
      #         ref: `refs/tags/${tag}`,
      #         sha: context.sha
